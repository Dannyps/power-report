#!/usr/bin/env python3
"""Refuse to commit secrets. Runs as the pre-commit hook (bin/hooks/pre-commit); `bin/secret-scan --all`
scans every tracked file instead of the staged ones.

Blocks: Apache SessionCryptoPassphrase values, private keys, tokens of known formats, password/secret/token
assignments with a literal value, and files that are secrets by name (.env, .htpasswd, *.pem, *.key, id_*).
Secrets belong in files on the host (e.g. /etc/apache2/internal-secrets.conf), never in this repo.
"""

import re
import subprocess
import sys

NAMES = re.compile(r'(^|/)(\.env(\..*)?|\.htpasswd|.*\.pem|.*\.key|id_(rsa|ecdsa|ed25519)(\.pub)?|internal-secrets\.conf)$')
PATTERNS = [
    (re.compile(r'^\s*SessionCryptoPassphrase\s+\S', re.I | re.M), 'Apache session passphrase'),
    (re.compile(r'-----BEGIN [A-Z ]*PRIVATE KEY-----'), 'private key'),
    (re.compile(r'\b(ghp|gho|ghu|ghs|github_pat)_[A-Za-z0-9_]{20,}'), 'GitHub token'),
    (re.compile(r'\bAKIA[0-9A-Z]{16}\b'), 'AWS key'),
    (re.compile(r'\bxox[abpr]-[A-Za-z0-9-]{10,}'), 'Slack token'),
    (re.compile(r'(?i)\b(password|passwd|secret|api[_-]?key|token)\b\s*[:=]\s*["\']?[A-Za-z0-9+/_\-]{12,}'), 'credential assignment'),
]


def git(*args: str) -> str:
    return subprocess.run(['git', *args], capture_output=True, text=True, check=True).stdout


def main() -> int:
    if '--all' in sys.argv:
        files = git('ls-files').split('\n')
        read = lambda f: open(f, 'rb').read()  # noqa: E731
    else:
        files = git('diff', '--cached', '--name-only', '--diff-filter=ACMR').split('\n')
        read = lambda f: subprocess.run(['git', 'show', f':{f}'], capture_output=True, check=True).stdout  # noqa: E731
    bad = []
    for f in filter(None, files):
        if NAMES.search(f):
            bad.append(f'{f}: secret file by name')
            continue
        try:
            text = read(f).decode('utf-8')
        except UnicodeDecodeError:
            continue
        for rx, what in PATTERNS:
            for mm in rx.finditer(text):
                line = text.count('\n', 0, mm.start()) + 1
                bad.append(f'{f}:{line}: {what}')
    for b in bad:
        print('secret-scan: ' + b, file=sys.stderr)
    if bad:
        print('secret-scan: commit refused. Move the secret to a file on the host (see README, "Secrets").', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
